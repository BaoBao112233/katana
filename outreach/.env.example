# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in your values
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=your_strong_password_here
DATABASE_URL=postgresql+asyncpg://postgres:your_strong_password_here@localhost:5432/companydb
DATABASE_URL_SYNC=postgresql://postgres:your_strong_password_here@localhost:5432/companydb

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=companies

# ── AI: Groq ──────────────────────────────────────────────────────────────────
# Get key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/GPT-OSS-20B
GROQ_TEMPERATURE=0.0
GROQ_MAX_TOKENS=1024
AI_MAX_HTML_CHARS=4000

# ── Google APIs ───────────────────────────────────────────────────────────────
# Custom Search API: https://developers.google.com/custom-search/v1/introduction
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CX=your_custom_search_engine_id

# Google Maps Places API: https://developers.google.com/maps/documentation/places
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ── Enrichment APIs ───────────────────────────────────────────────────────────
# Hunter.io: https://hunter.io/api-documentation
HUNTER_API_KEY=your_hunter_api_key

# Apollo.io: https://developer.apollo.io (optional)
APOLLO_API_KEY=

# Clearbit: https://clearbit.com/docs (optional)
CLEARBIT_API_KEY=

# ── Crawler ───────────────────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
CRAWLER_CONCURRENCY=10
CRAWLER_RATE_LIMIT_RPS=2.0

# ── Proxy (optional) ─────────────────────────────────────────────────────────
# File with one proxy per line: http://user:pass@host:port
PROXY_LIST_PATH=
PROXY_ROTATION_ENABLED=false

# ── SaaS API ──────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=change-me-in-production-please
API_ALLOWED_ORIGINS=["*"]

# ── Common Crawl ─────────────────────────────────────────────────────────────
# Latest index: https://commoncrawl.org/the-data/get-started/
COMMON_CRAWL_INDEX=CC-MAIN-2024-51
COMMON_CRAWL_MAX_DOMAINS=1000000

# ── Kafka (production only — set USE_KAFKA=true to enable) ──────────────────
USE_KAFKA=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW_DOMAINS=raw_domains
KAFKA_TOPIC_TO_CRAWL=to_crawl
KAFKA_TOPIC_CRAWLED=crawled
